# Copy to .env and fill in. NEVER commit .env.
# IBKR Flex Web Service (READ ONLY). Create a Flex Query in Client Portal:
#   Performance & Reports -> Flex Queries -> Activity Flex Query
# Sections needed: Trades, Cash Transactions, Open Positions (optional), Account Information.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

