# Copy to .env and fill in. NEVER commit .env.
# IBKR Flex Web Service (READ ONLY). Create a Flex Query in Client Portal:
#   Performance & Reports -> Flex Queries -> Activity Flex Query
# Sections needed: Trades, Cash Transactions, Open Positions (optional), Account Information.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Optional overrides
# INVESTOR_DB_PATH=data/investor.db
# INVESTOR_CONFIG_PATH=config/settings.yaml

# --- v3 intelligence (optional) ---
# SEC requires a descriptive User-Agent including a contact email for EDGAR requests:
SEC_USER_AGENT="InvestorOS/3.0 yourname yourmail@example.com"
# Local AI (llama.cpp server, OpenAI-compatible). The app works without it.
# AI_PROVIDER=llama_cpp
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_MODEL=meta-muse-glimmer-30b
